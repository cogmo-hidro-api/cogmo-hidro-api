{
  "name": "cogmo-hidro-api",
  "version": "1.0.0",
  "description": "API REST de monitoramento hidrológico (Cogmo) – Projeto Integrador. Dados simulados.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:fresh": "node src/database/fresh.js && npm run db:reset"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogmo-hidro-api/cogmo-hidro-api.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cogmo-hidro-api/cogmo-hidro-api/issues"
  },
  "homepage": "https://github.com/cogmo-hidro-api/cogmo-hidro-api#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  }
}
